{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ncnlp.local/schemas/rq3-variant-run-v1.json",
  "title": "RQ3 ablation variant run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "config_id",
    "task_id",
    "case_id",
    "repeat_index",
    "status",
    "actions",
    "final_state",
    "usage",
    "latency_ms",
    "attempt_count",
    "cache_enabled",
    "error"
  ],
  "properties": {
    "schema_version": {"const": "rq3-variant-run-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "config_id": {"enum": ["model_assign", "fused", "no_check", "model_code", "rule_recover", "model_exec"]},
    "task_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "repeat_index": {"type": "integer", "minimum": 1},
    "status": {"enum": ["success", "method_error", "parse_error", "execution_error", "timeout", "protocol_violation"]},
    "actions": {"type": "array", "items": {"type": "object"}},
    "final_state": {"type": "object"},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_tokens", "completion_tokens", "total_tokens", "cached_tokens"],
      "properties": {
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "cached_tokens": {"const": 0}
      }
    },
    "latency_ms": {"type": "integer", "minimum": 0},
    "attempt_count": {"type": "integer", "minimum": 1},
    "cache_enabled": {"const": false},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "type", "message"],
      "properties": {
        "stage": {"type": "string"},
        "type": {"type": "string"},
        "message": {"type": "string"}
      }
    },
    "raw_artifact_paths": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"}
  }
}
