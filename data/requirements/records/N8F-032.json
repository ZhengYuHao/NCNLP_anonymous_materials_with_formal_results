  "requirement": {
    "requirement_text": "系统以一条 YouTube 视频链接为输入，获取该视频的字幕文本，并由语言模型基于字幕生成博客文章与社交媒体内容。内容在发布前可选择等待人工批准；未启用人工批准时直接发布。生成的内容发布到选定的发布平台，并对每次处理结果进行记录以便追踪。",
    "source_spans": [
      {
        "start": 10,
        "end": 166,
        "text": "This workflow turns a single YouTube video into multiple content formats and publishes them across different platforms with an optional human approval step."
      },
      {
        "start": 324,
        "end": 531,
        "text": "Fetches the transcript from a YouTube video  \nUses AI to generate blog and social media content  \nOptionally waits for manual approval  \nPublishes content to selected platforms  \nLogs the result for tracking"
      }
    ],
    "transformation_operations": [
      "select_behavior_span",
      "remove_marketing",
      "remove_setup",
      "join_adjacent_behavior_items",
      "normalize_whitespace",
      "replace_product_name_with_role"
    ],
