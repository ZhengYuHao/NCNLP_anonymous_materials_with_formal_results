  "requirement": {
    "requirement_text": "系统需要让使用者以自然语言直接查询 PostgreSQL 数据库：使用者先提供一次目标数据表名，之后即可用自然语言提出问题。系统由语言模型将问题转换为 SQL 并直接对数据库执行查询，无需使用者导出数据或上传数据文件，也无需使用者编写 SQL；查询结果以整理后的分析结论返回给使用者。",
    "source_spans": [
      {
        "start": 24,
        "end": 80,
        "text": "Chat With Any PostgreSQL Database Using Natural Language"
      },
      {
        "start": 84,
        "end": 168,
        "text": "This template turns your PostgreSQL database into an AI-powered analytics assistant."
      },
      {
        "start": 170,
        "end": 332,
        "text": "Instead of exporting data or uploading huge CSV files to an LLM, this workflow lets AI query your database directly using SQL, returning clean insights instantly."
      },
      {
        "start": 334,
        "end": 409,
        "text": "Just type your table name once and start asking questions in plain English."
      },
      {
        "start": 411,
        "end": 427,
        "text": "No SQL required."
      }
    ],
