          "expected": "owner1@example.com",
          "rationale": "房产所有人必须收到通知邮件"
        },
        {
          "assertion_id": "A-POS-09",
          "target": "output.emails[*].body",
          "operator": "contains",
          "expected": "Flood damage assessment",
          "rationale": "邮件必须附带完整的受损评估报告"
