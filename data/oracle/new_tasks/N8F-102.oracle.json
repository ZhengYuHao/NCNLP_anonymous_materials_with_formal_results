          "assertion_id": "A-UQ-14",
          "target": "exec_log.publish.instagram_reels.published",
          "operator": "equals",
          "expected": true,
          "rationale": "视频必须发布到 Instagram Reels"
        },
        {
          "assertion_id": "A-UQ-15",
          "target": "exec_log.publish.youtube_shorts.published",
          "operator": "equals",
