  "cases": [
    {
      "case_id": "C-ONE-UNPOSTED-QUOTE",
      "kind": "positive",
      "fixture_ids": ["F-SHEET-ONE-UNPOSTED"],
      "mock_ids": [
        "M-LLM-SCRIPT-CAPTIONS",
        "M-ELEVENLABS-VOICE",
        "M-VEO3-RENDER",
        "M-CREATOMATE-MERGE",
        "M-CLOUDINARY-UPScale",
        "M-POSTIZ-PUBLISH",
        "M-SHEETS-MARK-POSTED"
      ],
      "assertions": [
        {
          "assertion_id": "A-UQ-1",
          "target": "exec_log.selected_quote_id",
          "operator": "equals",
          "expected": "q-01",
          "rationale": "每次运行必须只选取一条尚未发布的语录行，本用例应选中第一条未发布语录 q-01"
        },
        {
          "assertion_id": "A-UQ-2",
          "target": "exec_log.selected_quote_id",
          "operator": "not_equals",
          "expected": "q-02",
          "rationale": "已发布（status=posted）的语录不得被再次处理"
        },
        {
          "assertion_id": "A-UQ-3",
          "target": "exec_log.processed_quote_count",
          "operator": "equals",
          "expected": 1,
          "rationale": "需求要求每次运行只处理一条语录行，避免重复发布或遗漏"
        },
        {
          "assertion_id": "A-UQ-4",
          "target": "exec_log.storyboard",
          "operator": "length_equals",
          "expected": 2,
          "rationale": "分镜脚本必须包含语言模型生成的全部场景"
        },
        {
          "assertion_id": "A-UQ-5",
          "target": "exec_log.captions.tiktok",
          "operator": "exists",
          "expected": true,
          "rationale": "必须生成适用于 TikTok 的发布文案"
        },
        {
          "assertion_id": "A-UQ-6",
          "target": "exec_log.captions.instagram_reels",
          "operator": "exists",
          "expected": true,
          "rationale": "必须生成适用于 Instagram Reels 的发布文案"
        },
        {
          "assertion_id": "A-UQ-7",
          "target": "exec_log.captions.youtube_shorts",
          "operator": "exists",
          "expected": true,
          "rationale": "必须生成适用于 YouTube Shorts 的发布文案"
        },
        {
          "assertion_id": "A-UQ-8",
          "target": "exec_log.render.resolution",
          "operator": "equals",
          "expected": "1080x1920",
          "rationale": "视频必须为竖版 1080x1920 规格"
        },
        {
          "assertion_id": "A-UQ-9",
          "target": "exec_log.render.duration_sec",
          "operator": "equals",
          "expected": 8,
          "rationale": "需求要求视频时长为 8 秒"
        },
        {
          "assertion_id": "A-UQ-10",
          "target": "exec_log.voiceover.duration_sec",
