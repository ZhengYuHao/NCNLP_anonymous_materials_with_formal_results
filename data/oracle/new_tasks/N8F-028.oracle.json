  "cases": [
    {
      "case_id": "C-pos-main",
      "kind": "positive",
      "fixture_ids": [
        "F-leads",
        "F-owners"
      ],
      "mock_ids": [
        "M-hubspot-search",
        "M-llm-email",
        "M-gmail-draft",
        "M-slack-notify"
      ],
      "assertions": [
        {
          "assertion_id": "A-1",
          "target": "output.fetched_leads",
          "operator": "length_equals",
          "expected": 20,
          "rationale": "单次最多拉取 20 条线索，虽然 mock 返回 25 条，处理集合不得超过 20"
        },
        {
          "assertion_id": "A-2",
          "target": "output.processed_leads",
          "operator": "length_equals",
          "expected": 5,
          "rationale": "前 20 条中仅 5 条为 bad_timing，第 21 条（late1）虽为 bad_timing 但超出 20 条上限不应被处理"
        },
        {
          "assertion_id": "A-3",
          "target": "output.processed_leads[].status",
          "operator": "equals",
          "expected": "bad_timing",
          "rationale": "仅处理因时机不当被暂停的线索，处理集合中不应出现 active 等其它状态"
        },
        {
          "assertion_id": "A-4",
          "target": "output.processed_leads[0].id",
          "operator": "equals",
          "expected": "lead1",
          "rationale": "处理集合按拉取顺序保留 bad_timing 线索，首条应为 lead1；结合 A-2（数量 5）与 A-3（全部为 bad_timing），处理集合被唯一确定为 {lead1..lead5}，从而验证 active 状态线索（如 active1）与第 21 条起的 late1 均未被处理"
        },
        {
          "assertion_id": "A-5",
          "target": "output.drafts",
          "operator": "length_equals",
          "expected": 5,
          "rationale": "每个合格线索须在 Gmail 中创建一封草稿"
        },
        {
          "assertion_id": "A-6",
          "target": "output.sent_emails",
          "operator": "not_exists",
          "rationale": "流程不自动发送邮件，只创建草稿供人工审阅",
          "expected": false
        },
        {
          "assertion_id": "A-7",
          "target": "output.slack_notifications",
          "operator": "length_equals",
          "expected": 5,
          "rationale": "每个合格线索须向负责人发送一次 Slack 通知"
        }
      ]
    },
    {
