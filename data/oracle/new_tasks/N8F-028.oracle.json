          "operator": "exists",
          "rationale": "草稿须整理出主题字段",
          "expected": true
        },
        {
          "assertion_id": "A-2-pos-normalize",
          "target": "output.drafts[0].body",
          "operator": "exists",
          "rationale": "草稿须整理出正文（简短友好、无 CRM 标签、无推销口吻）",
          "expected": true
        },
        {
