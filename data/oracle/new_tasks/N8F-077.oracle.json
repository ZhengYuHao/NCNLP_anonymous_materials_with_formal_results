      "dependency_type": "n8n-nodes-base.slack",
      "operation": "post_reply",
      "request_contract": {
        "channel": "C123456",
        "thread_ts": "1700000000.000100",
        "text": "The total revenue for Q3 was $4.2M."
      },
      "response_contract": {
        "ok": true,
        "ts": "1700000100.000300"
      },
      "deterministic": true,
      "side_effects_disabled": true
    },
    {
      "mock_id": "M-DB-LLM-PLAN-ERROR",
      "dependency_type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "operation": "plan_sql",
      "request_contract": {
        "question": "How many stores in Texas?",
        "schema_present": true
      },
      "response_contract": {
        "sql": "SELECT COUNT(*) AS store_count FROM stores WHERE state = 'Texas'"
