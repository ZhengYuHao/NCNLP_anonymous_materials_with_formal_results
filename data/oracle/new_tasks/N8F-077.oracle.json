      "deterministic": true,
      "side_effects_disabled": true
    },
    {
      "mock_id": "M-DB-SLACK-ERROR",
      "dependency_type": "n8n-nodes-base.slack",
      "operation": "post_error_message",
      "request_contract": {
        "channel": "C123457"
      },
      "response_contract": {
        "ok": true,
        "ts": "1700000200.000400"
      },
      "deterministic": true,
      "side_effects_disabled": true
    }
  ],
  "cases": [
    {
      "case_id": "C-FIRST-QUESTION-ANSWERED",
