      "deterministic": true,
      "side_effects_disabled": true
    },
    {
      "mock_id": "M-DB-EXECUTE-FAIL",
      "dependency_type": "n8n-nodes-base.httpRequest",
      "operation": "execute_sql",
      "request_contract": {
        "sql_present": true
