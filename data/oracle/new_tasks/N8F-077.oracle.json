  "fixtures": [
    {
      "fixture_id": "F-DB-FIRST-QUESTION",
      "purpose": "正常用例：用户在 Slack 频道 @提及机器人并提出问题，应获取表结构、由语言模型生成 SQL、执行查询、解读结果并回复到 Slack 会话",
      "input_data": {
        "slack_thread_ts": "1700000000.000100",
        "channel": "C123456",
        "question": "What was the total revenue in Q3?",
        "target_table": "sales",
        "warehouse_id": "wh-main"
      }
    },
    {
      "fixture_id": "F-DB-FOLLOWUP",
      "purpose": "正常用例：用户在同一线程追问（如“现在只显示前 5 条”），应利用线程历史理解指代，无需重复完整上下文直接执行新查询",
      "input_data": {
        "slack_thread_ts": "1700000000.000100",
        "channel": "C123456",
        "question": "Now show me only the top 5",
        "target_table": "sales",
        "warehouse_id": "wh-main",
        "thread_history": [
          {
            "role": "user",
            "content": "What was the total revenue in Q3?"
          },
          {
            "role": "assistant",
            "content": "The total revenue for Q3 was $4.2M."
          }
        ]
      }
    },
    {
      "fixture_id": "F-DB-ERROR",
      "purpose": "安全拒绝用例：SQL 执行失败导致无法产出可发送的回复，应向用户发送错误提示消息，避免用户空等",
      "input_data": {
        "slack_thread_ts": "1700000001.000200",
        "channel": "C123457",
        "question": "How many stores in Texas?",
        "target_table": "stores",
        "warehouse_id": "wh-main"
      }
    }
  ],
  "mocks": [
    {
      "mock_id": "M-DB-DESCRIBE",
      "dependency_type": "n8n-nodes-base.httpRequest",
      "operation": "describe_table",
      "request_contract": {
        "table": "sales"
      },
      "response_contract": {
        "columns": [
          {
            "name": "price",
            "type": "decimal"
          },
          {
            "name": "date",
            "type": "date"
          },
          {
            "name": "store_id",
            "type": "string"
          }
        ]
      },
      "deterministic": true,
      "side_effects_disabled": true
    },
    {
      "mock_id": "M-DB-LLM-PLAN",
      "dependency_type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "operation": "plan_sql",
      "request_contract": {
        "question": "What was the total revenue in Q3?",
        "schema_present": true
      },
      "response_contract": {
        "sql": "SELECT SUM(price) AS total_revenue FROM sales WHERE date BETWEEN '2026-07-01' AND '2026-09-30'"
      },
      "deterministic": true,
      "side_effects_disabled": true
    },
    {
      "mock_id": "M-DB-EXECUTE",
      "dependency_type": "n8n-nodes-base.httpRequest",
      "operation": "execute_sql",
      "request_contract": {
        "sql": "SELECT SUM(price) AS total_revenue FROM sales WHERE date BETWEEN '2026-07-01' AND '2026-09-30'"
      },
      "response_contract": {
        "rows": [
          {
            "total_revenue": 4200000
          }
        ]
      },
      "deterministic": true,
      "side_effects_disabled": true
    },
    {
      "mock_id": "M-DB-LLM-INTERPRET",
      "dependency_type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
