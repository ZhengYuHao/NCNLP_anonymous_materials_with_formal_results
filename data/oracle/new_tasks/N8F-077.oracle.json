        }
      ]
    },
    {
      "case_id": "C-FOLLOWUP-THREAD",
      "kind": "positive",
      "fixture_ids": [
        "F-DB-FOLLOWUP"
      ],
      "mock_ids": [
        "M-DB-MEMORY-LOAD",
        "M-DB-DESCRIBE",
        "M-DB-LLM-PLAN",
        "M-DB-EXECUTE",
