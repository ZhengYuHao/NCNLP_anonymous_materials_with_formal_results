  "cases": [
    {
      "case_id": "C-PARTIAL-TAGS-POSITIVE",
      "kind": "positive",
      "fixture_ids": ["F-POST-ID"],
      "mock_ids": [
        "M-WP-GET-POST",
        "M-WP-GET-TAGS",
        "M-LLM-ANALYZE-PARTIAL",
        "M-WP-CREATE-TAG-1",
        "M-WP-CREATE-TAG-2",
        "M-WP-UPDATE-POST"
      ],
      "assertions": [
        {
          "assertion_id": "A-PART-1",
          "target": "exec_log.mock_calls.M-WP-GET-POST.count",
          "operator": "equals",
          "expected": 1,
          "rationale": "必须根据文章标识获取指定文章内容"
        },
        {
          "assertion_id": "A-PART-2",
          "target": "exec_log.mock_calls.M-WP-GET-TAGS.count",
          "operator": "equals",
          "expected": 1,
          "rationale": "必须获取站点上已有的全部标签"
        },
        {
          "assertion_id": "A-PART-3",
          "target": "exec_log.mock_calls.M-WP-CREATE-TAG-1.count",
          "operator": "equals",
          "expected": 1,
          "rationale": "模型建议的新标签必须逐个调用接口创建"
        },
        {
          "assertion_id": "A-PART-4",
          "target": "exec_log.mock_calls.M-WP-CREATE-TAG-2.count",
          "operator": "equals",
          "expected": 1,
          "rationale": "第二个建议新标签也必须被创建"
        },
        {
          "assertion_id": "A-PART-5",
          "target": "exec_log.mock_calls.M-WP-UPDATE-POST.request_contract.tags",
          "operator": "length_equals",
          "expected": 4,
          "rationale": "最终分配给文章的标签总数必须为 4（2 个已有 + 2 个新建）"
        },
        {
          "assertion_id": "A-PART-6",
          "target": "exec_log.mock_calls.M-WP-UPDATE-POST.request_contract.tags",
          "operator": "equals",
          "expected": [103, 101, 201, 202],
          "rationale": "标签列表必须由已选中已有标签 ID 与新建标签 ID 合并而成，顺序与内容可精确比对"
        },
        {
          "assertion_id": "A-PART-7",
          "target": "exec_log.mock_calls.M-WP-UPDATE-POST.request_contract.tags[2]",
          "operator": "equals",
          "expected": 201,
          "rationale": "新建标签 ID 必须取自创建接口返回的 ID，而不是随意编号"
        }
      ]
    },
    {
      "case_id": "C-FULL-TAGS-BOUNDARY",
      "kind": "boundary",
      "fixture_ids": ["F-POST-ID-FULL-TAGS"],
      "mock_ids": [
        "M-WP-GET-POST",
        "M-WP-GET-TAGS",
        "M-LLM-ANALYZE-FULL",
        "M-WP-UPDATE-POST-FULL"
