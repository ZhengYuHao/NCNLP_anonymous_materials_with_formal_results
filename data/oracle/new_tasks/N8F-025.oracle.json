      "assertions": [
        {
          "assertion_id": "A-FULL-1",
          "target": "exec_log.mock_calls.M-WP-CREATE-TAG-1.count",
          "operator": "equals",
          "expected": 0,
          "rationale": "已有标签已可选满 4 个时不得创建任何新标签"
        },
        {
          "assertion_id": "A-FULL-2",
          "target": "exec_log.mock_calls.M-WP-UPDATE-POST-FULL.request_contract.tags",
          "operator": "length_equals",
          "expected": 4,
          "rationale": "最终标签总数保持 4 个，不多不少"
        },
        {
          "assertion_id": "A-FULL-3",
          "target": "exec_log.mock_calls.M-WP-UPDATE-POST-FULL.request_contract.tags",
          "operator": "equals",
          "expected": [101, 102, 103, 104],
          "rationale": "全部使用已有标签 ID，且与模型输出一致"
        }
      ]
    }
  ],
  "replay_plan": {
    "repeat_count": 3,
    "identical_inputs": true,
    "evidence_generated_after_execution": true
  },
  "notes": "覆盖标签生成主流程（2 个已有 + 2 个新建 → 最终 4 个）与边界场景（已有标签充足时不创建新标签）。WordPress REST 接口与 LLM 全部固定模拟；断言检查获取文章/标签调用、新标签逐个创建次数、最终更新请求中标签数组的长度与精确内容，均为可计算比对。"
