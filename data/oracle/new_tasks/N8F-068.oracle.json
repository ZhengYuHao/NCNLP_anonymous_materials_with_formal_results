  "cases": [
    {
      "case_id": "C-pos-pdf",
      "kind": "positive",
      "fixture_ids": [
        "F-email-pdf"
      ],
      "mock_ids": [
        "M-pdf-extract",
        "M-llm-rewrite",
        "M-llm-assess",
        "M-gmail-reply"
      ],
      "assertions": [
