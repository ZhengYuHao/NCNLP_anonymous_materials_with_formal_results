      "purpose": "收到的新邮件：含 1 个 PDF 附件与 1 个 JPG 附件，JPG 应被剔除",
      "input_data": {
        "from": "pr@company.com",
        "subject": "Press release: new product",
        "body": "Please find the press release attached.",
        "attachments": [
          {
            "name": "release.pdf",
            "mime": "application/pdf"
          },
          {
            "name": "photo.jpg",
            "mime": "image/jpeg"
          }
        ]
      }
    },
    {
      "fixture_id": "F-email-word",
      "purpose": "收到的新邮件：含 1 个 Word 附件",
      "input_data": {
        "from": "pr@company.com",
        "subject": "Press release: partnership",
        "body": "Please find the press release attached.",
        "attachments": [
          {
            "name": "release.docx",
            "mime": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
          }
        ]
      }
    },
    {
      "fixture_id": "F-email-inline",
      "purpose": "收到的新邮件：无附件，仅内联正文",
      "input_data": {
        "from": "pr@company.com",
        "subject": "Press release: launch",
        "body": "Inline press release text about new product launch on September 1.",
