          "assertion_id": "A-1",
          "target": "output.filtered_attachments",
          "operator": "length_equals",
          "expected": 1,
          "rationale": "JPG 附件被剔除后，仅保留 PDF 附件"
        },
        {
          "assertion_id": "A-2",
          "target": "output.filtered_attachments[0].name",
