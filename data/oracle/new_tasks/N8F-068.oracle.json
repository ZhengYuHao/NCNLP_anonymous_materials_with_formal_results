        {
          "assertion_id": "A-6",
          "target": "output.reply.article",
          "operator": "exists",
          "rationale": "回复邮件须包含生成的文章部分",
          "expected": true
        },
        {
          "assertion_id": "A-7",
          "target": "output.reply.self_assessment.score",
          "operator": "equals",
          "expected": 0.9,
          "rationale": "回复邮件须包含独立评估环节生成的自评（分数为固定模拟值）"
        },
        {
          "assertion_id": "A-8",
          "target": "output.reply.message_id",
          "operator": "exists",
          "rationale": "应向原发件人成功发送回复邮件",
          "expected": true
        }
      ]
    },
    {
