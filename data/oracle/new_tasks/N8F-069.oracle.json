    {
      "mock_id": "M-EC-SHOPIFY-FAIL",
      "dependency_type": "n8n-nodes-base.shopify",
      "operation": "create_product",
      "request_contract": {
        "platform": "shopify"
      },
      "response_contract": {
        "error": "api_rejected",
        "status": "error"
      },
      "deterministic": true,
      "side_effects_disabled": true
    }
  ],
  "cases": [
    {
      "case_id": "C-REMOTE-SHOPIFY-CREATED",
      "kind": "positive",
      "fixture_ids": [
        "F-EC-REMOTE-SHOPIFY"
      ],
      "mock_ids": [
        "M-EC-UPLOAD",
        "M-EC-VISION",
        "M-EC-SHOPIFY-CREATE"
      ],
      "assertions": [
        {
          "assertion_id": "A-SH-1",
          "target": "exec_log.uploadToUrl.host_image.calls",
          "operator": "equals",
          "expected": 1,
          "rationale": "商品图片必须先交由图片托管服务托管"
        },
        {
          "assertion_id": "A-SH-2",
          "target": "exec_log.lmChatOpenAi.analyze_product_image.request.image_url",
          "operator": "equals",
          "expected": "https://mock-cdn.example.com/store/headphones-0001.jpg",
          "rationale": "视觉分析必须使用托管服务返回的固定访问链接"
        },
        {
          "assertion_id": "A-SH-3",
          "target": "output.enriched.title",
          "operator": "exists",
          "expected": true,
          "rationale": "必须基于图像识别生成商品标题"
        },
        {
          "assertion_id": "A-SH-4",
          "target": "output.enriched.bullet_features.length",
          "operator": "equals",
          "expected": 5,
          "rationale": "必须生成五条要点式的产品卖点"
        },
        {
          "assertion_id": "A-SH-5",
          "target": "output.enriched.seo_title",
          "operator": "matches",
          "expected": "^.{1,70}$",
          "rationale": "SEO 标题长度不得超过 70 字符"
        },
        {
          "assertion_id": "A-SH-6",
          "target": "output.cleaned.sku",
          "operator": "equals",
          "expected": "HP-1001",
          "rationale": "SKU 必须经过清洗去除首尾空白"
        },
        {
          "assertion_id": "A-SH-7",
          "target": "exec_log.shopify.create_product.request.platform",
          "operator": "equals",
          "expected": "shopify",
          "rationale": "必须按目标平台 Shopify 格式化并创建商品条目"
        },
        {
          "assertion_id": "A-SH-8",
          "target": "exec_log.shopify.create_product.request.handle",
          "operator": "equals",
          "expected": "wireless-noise-cancelling-headphones",
          "rationale": "必须生成基于建议商品名称的 URL 友好标识"
        }
      ]
    },
    {
      "case_id": "C-MOBILE-WOO-CREATED",
      "kind": "positive",
      "fixture_ids": [
        "F-EC-MOBILE-WOO"
      ],
      "mock_ids": [
        "M-EC-UPLOAD",
        "M-EC-VISION",
