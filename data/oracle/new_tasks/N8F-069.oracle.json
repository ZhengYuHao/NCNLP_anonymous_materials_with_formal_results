          "rationale": "错误信息必须携带具体的失败原因"
        },
        {
          "assertion_id": "A-EF-3",
          "target": "exec_log.lmChatOpenAi.analyze_product_image.calls",
          "operator": "not_exists",
          "expected": true,
          "rationale": "图片托管失败时不得继续视觉识别流程"
        },
        {
          "assertion_id": "A-EF-4",
          "target": "exec_log.shopify.create_product.calls",
