  "mocks": [
    {
      "mock_id": "M-EC-UPLOAD",
      "dependency_type": "n8n-nodes-uploadtourl.uploadToUrl",
      "operation": "host_image",
      "request_contract": {
        "image_url_or_binary_present": true,
        "binary_present": true
      },
      "response_contract": {
        "permanent_url": "https://mock-cdn.example.com/store/headphones-0001.jpg"
      },
      "deterministic": true,
      "side_effects_disabled": true
    },
    {
      "mock_id": "M-EC-VISION",
      "dependency_type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "operation": "analyze_product_image",
      "request_contract": {
        "image_url": "https://mock-cdn.example.com/store/headphones-0001.jpg"
      },
      "response_contract": {
        "title": "Wireless Noise-Cancelling Headphones",
        "html_description": "<p>Premium over-ear headphones with active noise cancellation.</p>",
        "seo_tags": [
          "wireless",
          "noise-cancelling",
          "headphones"
        ],
        "suggested_category": "Electronics > Audio",
        "bullet_features": [
          "40h battery",
          "Active ANC",
          "Bluetooth 5.3",
          "Foldable design",
          "Built-in mic"
