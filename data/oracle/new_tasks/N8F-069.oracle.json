    {
      "case_id": "C-PLATFORM-FAIL-ERROR",
      "kind": "safe_rejection",
      "fixture_ids": [
        "F-EC-PLATFORM-FAIL"
      ],
      "mock_ids": [
        "M-EC-UPLOAD",
        "M-EC-VISION",
        "M-EC-SHOPIFY-FAIL"
      ],
      "assertions": [
        {
          "assertion_id": "A-PF-1",
          "target": "output.error.structured",
          "operator": "equals",
