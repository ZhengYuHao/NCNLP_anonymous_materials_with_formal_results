      "input_data": {
        "image_source": {
          "type": "remote_url",
          "url": "https://example.com/products/headphones.jpg"
        },
        "target_platform": "shopify",
        "raw_product_data": {
          "sku": " HP-1001 ",
          "price": "$129.00",
          "inventory": "50"
        }
      }
    },
    {
      "fixture_id": "F-EC-MOBILE-WOO",
      "purpose": "正常用例：移动端上传图片文件，目标平台为 WooCommerce，应托管图片并生成带 Yoast SEO 与营销描述的条目",
      "input_data": {
        "image_source": {
          "type": "binary_upload",
          "file_name": "mug_photo.jpg",
          "binary": "base64-imagedata"
        },
        "target_platform": "woocommerce",
        "raw_product_data": {
          "sku": "MUG-207",
          "price": "19.99",
          "inventory": "120"
        }
      }
    },
    {
      "fixture_id": "F-EC-UPLOAD-FAIL",
      "purpose": "安全拒绝用例：图片托管服务调用失败，应停止后续流程并向调用方返回结构化错误信息",
      "input_data": {
        "image_source": {
          "type": "remote_url",
          "url": "https://example.com/broken.jpg"
        },
        "target_platform": "shopify",
        "raw_product_data": {
          "sku": "X-1",
          "price": "9.99",
          "inventory": "5"
        }
      }
    },
    {
      "fixture_id": "F-EC-PLATFORM-FAIL",
      "purpose": "安全拒绝用例：电商平台接口调用失败，应捕获失败并向调用方返回结构化错误信息",
      "input_data": {
        "image_source": {
          "type": "remote_url",
          "url": "https://example.com/valid.jpg"
        },
        "target_platform": "shopify",
        "raw_product_data": {
          "sku": "Y-2",
          "price": "49.99",
          "inventory": "10"
        }
      }
    }
