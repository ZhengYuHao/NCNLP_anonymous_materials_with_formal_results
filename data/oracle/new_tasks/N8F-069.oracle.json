        {
          "assertion_id": "A-WO-3",
          "target": "exec_log.httpRequest.create_woocommerce_product.request.platform",
          "operator": "equals",
          "expected": "woocommerce",
          "rationale": "目标平台为 WooCommerce 时必须走 WooCommerce 创建接口"
        },
        {
          "assertion_id": "A-WO-4",
          "target": "exec_log.httpRequest.create_woocommerce_product.request.yoast_seo_present",
          "operator": "equals",
          "expected": true,
          "rationale": "WooCommerce 条目必须包含 Yoast SEO 支持"
        },
        {
          "assertion_id": "A-WO-5",
          "target": "exec_log.shopify.create_product.calls",
          "operator": "not_exists",
          "expected": true,
          "rationale": "目标平台为 WooCommerce 时不得调用 Shopify 创建接口"
        }
      ]
    },
    {
