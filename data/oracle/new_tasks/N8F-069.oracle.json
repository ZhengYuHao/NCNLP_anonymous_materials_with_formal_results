    {
      "mock_id": "M-EC-WOO-CREATE",
      "dependency_type": "n8n-nodes-base.httpRequest",
      "operation": "create_woocommerce_product",
      "request_contract": {
        "platform": "woocommerce",
        "yoast_seo_present": true
      },
      "response_contract": {
        "product_id": 99001,
        "status": "created"
      },
      "deterministic": true,
      "side_effects_disabled": true
    },
    {
      "mock_id": "M-EC-UPLOAD-FAIL",
      "dependency_type": "n8n-nodes-uploadtourl.uploadToUrl",
