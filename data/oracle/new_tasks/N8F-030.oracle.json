  "cases": [
    {
      "case_id": "C-FIRST-ENTRY-INITIAL-SAVE",
      "kind": "positive",
      "fixture_ids": ["F-SHEET-FIRST-ENTRY"],
      "mock_ids": ["M-HTTP-SCRAPE", "M-LLM-EXTRACT-NEW", "M-SHEETS-UPDATE-FIRST"],
      "assertions": [
        {
          "assertion_id": "A-FE-1",
          "target": "exec_log.is_first_record",
          "operator": "equals",
          "expected": true,
          "rationale": "该商品无历史价格记录，必须判定为首次记录"
        },
        {
          "assertion_id": "A-FE-2",
          "target": "exec_log.sheets.update_row_initial.current_price",
          "operator": "equals",
          "expected": 89.99,
          "rationale": "首次记录应保存抓取并抽取到的当前价格作为初始值"
        },
        {
          "assertion_id": "A-FE-3",
          "target": "exec_log.sheets.update_row_initial.updated",
          "operator": "equals",
          "expected": true,
          "rationale": "初始值保存必须成功写入 Google Sheets"
        }
      ]
    },
    {
      "case_id": "C-CHANGED-UPDATES-RECORD",
      "kind": "positive",
      "fixture_ids": ["F-SHEET-CHANGED"],
