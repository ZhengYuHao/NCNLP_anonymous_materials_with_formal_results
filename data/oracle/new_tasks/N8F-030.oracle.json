        {
          "assertion_id": "A-UN-3",
          "target": "exec_log.sheets.update_row_no_change.current_price",
          "operator": "equals",
          "expected": 49.99,
          "rationale": "无变化更新必须保留与历史一致的当前价格值"
        }
