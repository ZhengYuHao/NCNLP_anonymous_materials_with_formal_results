        {
          "assertion_id": "A-FC-5",
          "target": "final_output.email.html_body",
          "operator": "contains",
          "expected": "Market Intelligence Report",
          "rationale": "邮件正文必须是 HTML 排版的市场情报报告"
        },
        {
          "assertion_id": "A-FC-6",
          "target": "exec_log.sheets.reset.reset",
          "operator": "equals",
          "expected": true,
          "rationale": "本轮结束后必须执行数据重置以进入下一轮"
        },
        {
          "assertion_id": "A-FC-7",
          "target": "exec_log.sheets.reset.rows_updated",
          "operator": "equals",
          "expected": 3,
          "rationale": "重置操作必须覆盖本轮全部 3 条处理过的商品记录"
        }
