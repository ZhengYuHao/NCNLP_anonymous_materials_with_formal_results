          "rationale": "当前价 89.99 与历史价 99.99 不同，必须判定价格发生变化"
        },
        {
          "assertion_id": "A-CH-2",
          "target": "exec_log.sheets.update_row_on_change.current_price",
          "operator": "equals",
          "expected": 89.99,
          "rationale": "检测到变化时记录必须更新为新抓取的价格"
        },
        {
          "assertion_id": "A-CH-3",
          "target": "exec_log.sheets.update_row_on_change.history_price",
          "operator": "equals",
          "expected": 99.99,
          "rationale": "更新时历史价格必须被保留或迁移，不得丢失历史值"
        },
        {
          "assertion_id": "A-CH-4",
          "target": "exec_log.sheets.update_row_on_change.updated",
          "operator": "equals",
          "expected": true,
          "rationale": "变化更新必须成功写入 Google Sheets"
        }
      ]
    },
    {
