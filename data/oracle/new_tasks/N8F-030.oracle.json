      "assertions": [
        {
          "assertion_id": "A-UN-1",
          "target": "exec_log.price_changed",
          "operator": "equals",
          "expected": false,
          "rationale": "当前价与历史价相同，必须判定价格未变化"
        },
        {
          "assertion_id": "A-UN-2",
          "target": "exec_log.sheets.update_row_no_change.updated",
          "operator": "equals",
          "expected": true,
          "rationale": "需求明确要求即使未检测到变化也会更新记录，未变化时也必须发生写入"
