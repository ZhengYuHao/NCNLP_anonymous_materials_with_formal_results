          {"id": "pin-2", "title": "Budget Kitchen Makeover", "impressions": 8000, "clicks": 640, "saves": 200, "engagement_rate": 0.105, "source": "organic"},
          {"id": "pin-3", "title": "Sponsored Decor Promo", "impressions": 15000, "clicks": 1500, "saves": 450, "engagement_rate": 0.13, "source": "paid"}
