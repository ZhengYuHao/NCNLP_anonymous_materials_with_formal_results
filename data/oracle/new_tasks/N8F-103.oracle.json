          "expected": "schedule",
          "rationale": "需求要求按计划（每日 8:00）启动，触发方式必须为定时计划"
        },
        {
          "assertion_id": "A-103-2",
          "target": "exec_log.pinterest.pins",
          "operator": "length_equals",
          "expected": 3,
          "rationale": "必须从 Pinterest API 获取近期的 Pin 表现数据，固定模拟返回 3 个 Pin"
        },
        {
          "assertion_id": "A-103-3",
          "target": "exec_log.pinterest.pins[0].impressions",
          "operator": "exists",
          "expected": true,
          "rationale": "Pin 表现数据必须包含展示量字段"
        },
        {
          "assertion_id": "A-103-4",
          "target": "exec_log.pinterest.pins[0].engagement_rate",
          "operator": "exists",
          "expected": true,
          "rationale": "Pin 表现数据必须包含互动率字段"
        },
        {
          "assertion_id": "A-103-5",
          "target": "exec_log.pinterest.pins[0].source",
          "operator": "equals",
          "expected": "organic",
          "rationale": "自然流量数据必须被正确标注为 organic"
        },
        {
          "assertion_id": "A-103-6",
          "target": "exec_log.pinterest.pins[2].source",
          "operator": "equals",
          "expected": "paid",
          "rationale": "付费广告数据必须被正确标注为 paid，与自然流量区分"
        },
        {
          "assertion_id": "A-103-7",
          "target": "exec_log.airtable.records_created",
          "operator": "equals",
          "expected": 3,
          "rationale": "所有 Pin 必须记录并归类存入 Airtable，记录数必须与 Pin 数一致"
        },
        {
          "assertion_id": "A-103-8",
          "target": "exec_log.llm.trending_topics",
          "operator": "contains",
          "expected": "home decor",
          "rationale": "语言模型必须识别热门话题与关键词，固定模拟输出中必须包含 home decor"
        },
        {
          "assertion_id": "A-103-9",
          "target": "exec_log.llm.best_formats",
          "operator": "contains",
          "expected": "video",
          "rationale": "语言模型必须识别最佳发布时段与内容形式，固定模拟输出必须包含 video 形式"
        },
        {
          "assertion_id": "A-103-10",
          "target": "exec_log.agent.recommendations",
          "operator": "length_equals",
          "expected": 2,
          "rationale": "智能体必须给出新的 Pin 创意与内容日历更新建议，固定模拟返回 2 条建议"
        },
        {
          "assertion_id": "A-103-11",
          "target": "exec_log.agent.recommendations[0].hashtags",
          "operator": "contains",
          "expected": "#budgetkitchen",
          "rationale": "建议必须包含话题标签，固定模拟建议中的标签必须保留"
