  "cases": [
    {
      "case_id": "C-PINTEREST-POSITIVE",
      "kind": "positive",
      "fixture_ids": ["F-SCHEDULE-DAILY"],
      "mock_ids": ["M-PINTEREST-PERFORMANCE", "M-AIRTABLE-LOG", "M-LLM-TREND-ANALYSIS", "M-AGENT-IDEA-RECOMMEND", "M-GMAIL-REPORT"],
      "assertions": [
