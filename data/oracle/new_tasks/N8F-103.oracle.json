        {
          "assertion_id": "A-103-13",
          "target": "exec_log.report",
          "operator": "contains",
          "expected": "Trending Content Ideas",
          "rationale": "报告必须包含热门内容创意章节"
        },
        {
          "assertion_id": "A-103-14",
          "target": "exec_log.report",
          "operator": "contains",
          "expected": "Best Performing Pin Formats",
          "rationale": "报告必须包含表现最佳的 Pin 形式章节"
