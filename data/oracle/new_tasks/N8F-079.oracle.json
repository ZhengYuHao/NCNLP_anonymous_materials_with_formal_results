          "assertion_id": "A-079-12",
          "target": "exec_log.googleCalendar.list.events",
          "operator": "length_equals",
          "expected": 2,
          "rationale": "必须检索未来 25 小时内即将开始的事件，固定模拟返回 2 个事件"
        },
        {
          "assertion_id": "A-079-13",
          "target": "exec_log.reminder_candidates",
          "operator": "length_equals",
          "expected": 2,
          "rationale": "两个事件分别距开始约 1 小时与 24 小时，均应进入提醒窗口筛选（固定模拟中约 1 小时与约 24 小时各一个）"
        },
        {
          "assertion_id": "A-079-14",
          "target": "exec_log.googleSheets.reminder_check.sent",
          "operator": "equals",
          "expected": false,
          "rationale": "必须先查询 ReminderLog 确认该事件在提醒窗口是否已发送过提醒，固定模拟中未发送"
        },
        {
          "assertion_id": "A-079-15",
          "target": "exec_log.telegram.reminder.send.count",
          "operator": "equals",
          "expected": 2,
          "rationale": "两个未发送过提醒的事件必须各发送一次 Telegram 提醒"
        },
        {
          "assertion_id": "A-079-16",
          "target": "exec_log.googleSheets.reminder_log_written",
          "operator": "length_equals",
          "expected": 2,
          "rationale": "每次发送提醒后必须登记该次提醒以避免重复发送"
        }
      ]
    },
    {
