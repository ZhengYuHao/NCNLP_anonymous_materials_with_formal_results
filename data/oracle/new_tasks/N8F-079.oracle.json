          "target": "exec_log.googleSheets.reminder_check.sent",
          "operator": "equals",
          "expected": true,
          "rationale": "ReminderLog 中已有该事件在该提醒窗口的发送记录"
        },
        {
          "assertion_id": "A-079-18",
          "target": "exec_log.telegram.reminder.send.count",
          "operator": "equals",
          "expected": 0,
          "rationale": "已发送过提醒的事件不得再次发送提醒"
        },
        {
          "assertion_id": "A-079-19",
          "target": "exec_log.googleSheets.reminder_log_written",
          "operator": "length_equals",
          "expected": 0,
          "rationale": "未发送提醒时不得重复登记"
        }
      ]
    }
