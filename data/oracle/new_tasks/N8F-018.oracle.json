  "cases": [
    {
      "case_id": "C-POS-FILTER-DEDUP",
      "kind": "positive",
      "fixture_ids": [
        "F-NEWS-PAYLOAD",
        "F-POSTED-TITLES"
      ],
      "mock_ids": [
        "M-FIRESTORE-GET",
        "M-NEWSAPI",
        "M-LLM-RICH",
        "M-LLM-SHORT",
        "M-IMG-DL-OK",
        "M-IMG-DL-FAIL",
        "M-LINKEDIN",
        "M-FIRESTORE-WRITE"
      ],
      "assertions": [
        {
          "assertion_id": "A-POS-01",
          "target": "output.posts",
          "operator": "length_equals",
          "expected": 3,
          "rationale": "仅 3 篇通过：TechCrunch 代表篇、无摘要的量子篇、图片防盗链回退篇；Biztoc 排除、缺图跳过、主题重复去重、Yahoo 跳过、已发布跳过"
        },
        {
          "assertion_id": "A-POS-02",
          "target": "output.posts[0].title",
          "operator": "contains",
          "expected": "AI Startup Raises $50M",
          "rationale": "按发布时间排序，最新文章排首位"
        },
        {
          "assertion_id": "A-POS-03",
          "target": "output.posts[0].with_media",
          "operator": "equals",
          "expected": true,
          "rationale": "图片下载成功时带图发布"
        },
        {
          "assertion_id": "A-POS-04",
          "target": "output.posts[2].with_media",
          "operator": "equals",
          "expected": false,
          "rationale": "图片下载失败（403）时改为纯文本发布"
        },
        {
          "assertion_id": "A-POS-05",
          "target": "output.posts[0].text",
          "operator": "contains",
          "expected": "#Startup",
          "rationale": "有摘要的文案为更丰富的变体且含话题标签"
        },
        {
          "assertion_id": "A-POS-06",
          "target": "output.posts[0].text",
          "operator": "matches",
          "expected": "^(?!.*https?).*$",
          "rationale": "文案不得包含链接"
        },
        {
          "assertion_id": "A-POS-07",
          "target": "output.posts[1].text",
          "operator": "equals",
          "expected": "Quantum chip breakthrough. Big moment. #Tech #Quantum",
          "rationale": "无摘要时使用简短文案变体，内容固定"
        },
        {
          "assertion_id": "A-POS-08",
          "target": "output.posts[*].text",
          "operator": "matches",
          "expected": "^([^#]*#[^#]*){2,3}$",
          "rationale": "每条文案恰含 2-3 个话题标签（以#计）"
        },
        {
          "assertion_id": "A-POS-09",
          "target": "output.published_titles",
          "operator": "length_equals",
          "expected": 3,
          "rationale": "发布成功后每篇文章标题写入已发布记录"
        },
        {
          "assertion_id": "A-POS-10",
          "target": "output.published_titles",
          "operator": "contains",
          "expected": "AI Startup Raises $50M Series B",
          "rationale": "成功发布的标题必须被记录"
        },
        {
          "assertion_id": "A-POS-11",
          "target": "output.skipped_articles",
          "operator": "length_equals",
          "expected": 5,
          "rationale": "被排除/跳过 5 篇：主题重复(The Verge)、排除源(Biztoc)、缺图(Some Blog)、Yahoo 同意页、已发布(Old News)"
        }
      ]
    },
