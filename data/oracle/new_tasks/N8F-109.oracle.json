      "side_effects_disabled": true
    },
    {
      "mock_id": "M-DA-READ-B",
      "dependency_type": "n8n-nodes-base.googleSheets",
      "operation": "read_dataset_b",
      "request_contract": {
        "sheet": "performance"
      },
      "response_contract": {
        "rows": [
          {"channel": "Search", "revenue": 8000},
          {"channel": "Social", "revenue": 4500},
          {"channel": "Email", "revenue": 1500},
          {"channel": "Display", "revenue": 300}
        ]
