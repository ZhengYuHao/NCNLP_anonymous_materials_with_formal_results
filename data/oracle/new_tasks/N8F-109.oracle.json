      "assertions": [
        {
          "assertion_id": "A-DA-1",
          "target": "exec_log.googleSheets.read_dataset_a.calls",
          "operator": "equals",
          "expected": 1,
          "rationale": "必须先读取第一个数据集"
        },
        {
          "assertion_id": "A-DA-2",
