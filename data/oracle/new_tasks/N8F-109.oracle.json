  "fixtures": [
    {
      "fixture_id": "F-DA-FULL-PIPELINE",
      "purpose": "正常用例：两个数据集按 Channel 合并，按 Clicks/Spend 筛选，按表现分为 Great/Poor，按团队负责人汇总，并生成指出最好与最差成员的分析",
      "input_data": {
        "dataset_a": [
          {"channel": "Search", "clicks": 1500, "spend": 1800, "leader": "Alice"},
          {"channel": "Social", "clicks": 900, "spend": 1200, "leader": "Bob"},
          {"channel": "Email", "clicks": 300, "spend": 400, "leader": "Alice"},
          {"channel": "Display", "clicks": 50, "spend": 3000, "leader": "Carol"}
        ],
        "dataset_b": [
          {"channel": "Search", "revenue": 8000},
          {"channel": "Social", "revenue": 4500},
          {"channel": "Email", "revenue": 1500},
          {"channel": "Display", "revenue": 300}
        ],
        "filter_rule": {
          "min_clicks": 100,
          "max_spend": 2500
        },
        "classification_rule": {
          "great_if_clicks_gte": 1000
        }
      }
    },
    {
      "fixture_id": "F-DA-BOUNDARY",
      "purpose": "边界用例：验证筛选边界，clicks 恰好等于最小阈值时保留，低于阈值时被过滤",
      "input_data": {
        "dataset_a": [
          {"channel": "Search", "clicks": 100, "spend": 1000, "leader": "Alice"},
          {"channel": "Social", "clicks": 99, "spend": 500, "leader": "Bob"}
        ],
        "dataset_b": [
          {"channel": "Search", "revenue": 2000},
          {"channel": "Social", "revenue": 1000}
        ],
        "filter_rule": {
          "min_clicks": 100,
          "max_spend": 2500
        },
        "classification_rule": {
          "great_if_clicks_gte": 1000
        }
      }
    }
  ],
  "mocks": [
