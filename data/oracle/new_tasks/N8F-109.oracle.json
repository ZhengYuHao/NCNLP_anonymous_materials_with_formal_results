        },
        {
          "assertion_id": "A-DA-7",
          "target": "output.classified.poor.length",
          "operator": "equals",
          "expected": 2,
          "rationale": "Social 与 Email 应归为 Poor"
        },
        {
          "assertion_id": "A-DA-8",
          "target": "output.summary_by_leader.keys",
          "operator": "contains",
          "expected": "Alice",
          "rationale": "汇总必须按团队负责人分组，Alice 应出现在分组中"
