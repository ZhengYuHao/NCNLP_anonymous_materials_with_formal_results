          "expected": true,
          "rationale": "语言模型必须基于汇总后的结果生成分析"
        },
        {
          "assertion_id": "A-DA-10",
          "target": "output.analysis",
          "operator": "contains",
          "expected": "Alice",
          "rationale": "书面分析必须指出表现最好的成员"
        },
        {
          "assertion_id": "A-DA-11",
          "target": "output.analysis",
          "operator": "contains",
          "expected": "Bob",
          "rationale": "书面分析必须指出表现最差的成员"
        }
      ]
    },
    {
      "case_id": "C-BOUNDARY-FILTER",
      "kind": "boundary",
      "fixture_ids": ["F-DA-BOUNDARY"],
      "mock_ids": ["M-DA-READ-A", "M-DA-READ-B", "M-DA-LLM-ANALYSIS"],
      "assertions": [
        {
          "assertion_id": "A-BD-1",
          "target": "output.filtered.length",
          "operator": "equals",
          "expected": 1,
          "rationale": "clicks 恰好等于最小阈值 100 的 Search 行必须保留，clicks=99 的 Social 行必须被过滤"
        },
        {
          "assertion_id": "A-BD-2",
          "target": "output.filtered[0].channel",
          "operator": "equals",
          "expected": "Search",
          "rationale": "边界处保留的行必须为满足 Clicks>=100 的 Search"
        }
      ]
    }
  ],
  "replay_plan": {
