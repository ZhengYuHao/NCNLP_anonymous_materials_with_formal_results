{
  "schema_version": "n8n-s1-system-task-v1",
  "task_id": "N8F-101",
  "dataset_partition": "development_qualification",
  "domain": "governance",
  "requirement_sha256": "5a67c53da6298958cb9f283ff6ab8efb72121a8b2560a4835f6bc19e8b10a5c1",
  "natural_language_requirement": "通过对话入口，用户用自然语言就表格提出问题（例如“哪个月最好？”、“按国家拆分收入？”、“哪些行缺少邮箱？”）。智能体读取 Google Sheets 中的实时数据行，基于真实数据计算并给出答案，而不是凭记忆猜测；对话记忆保留上下文，使“那之前一个月呢？”这类追问能够正常衔接；答案连同实际数字在对话中返回。",
  "public_interfaces": [
    {
      "dependency_type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "operation": "answer_question",
      "request_schema": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "history_length": {
                "type": "integer"
              },
              "question": {
                "type": "string"
              }
            },
            "required": [
              "history_length",
              "question"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              }
            },
            "required": [
              "question"
            ],
            "additionalProperties": false
          }
        ]
      },
      "response_schema": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string"
          }
        },
        "required": [
          "answer"
        ],
        "additionalProperties": false
      }
    },
    {
      "dependency_type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "operation": "load_context",
