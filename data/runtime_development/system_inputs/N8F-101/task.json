                      },
                      "required": [
                        "Email",
                        "Name"
                      ],
                      "type": "object"
                    }
                  ]
                },
                "type": "array"
              }
            },
            "required": [
              "rows"
            ],
            "type": "object"
          }
        ]
      }
    }
