              "description": "urlscan 成功时的发现",
              "properties": {
                "domains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "涉及的域名"
                },
                "requests": {
                  "type": "integer",
                  "description": "请求数量"
                },
                "resources": {
                  "type": "array",
                  "items": {
                    "type": "string"
