        "description": "语言模型给出的回答被回传到同一个 Telegram 会话中，作为对该用户的答复的发送结果",
        "requirement_evidence": [
          "语言模型给出的回答被回传到同一个 Telegram 会话中，作为对该用户的答复"
        ],
        "source_operations": [
          "send_message"
        ],
        "design_sources": [
