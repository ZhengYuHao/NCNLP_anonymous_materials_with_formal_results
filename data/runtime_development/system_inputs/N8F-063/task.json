        "schema": {
          "type": "string"
        },
        "description": "语言模型基于日程数据给出的回答",
        "requirement_evidence": [
          "据此交由语言模型处理用户在 Telegram 中提出的问题",
          "语言模型给出的回答被回传到同一个 Telegram 会话中，作为对该用户的答复"
        ],
        "source_operations": [
